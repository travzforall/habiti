{
  "table_name": "campaign_reports",
  "description": "One row per participant per period. Adjudication lives ON this row - confirmation is 1:1 with a report, so no separate adjudication table. Import NINETEENTH (depends on campaign_participants)",
  "import_order": 19,
  "dependencies": ["campaigns", "campaign_participants"],
  "notes": [
    "Periods are NEVER persisted as rows - they are a deterministic function of the locked rules plus starts_on. period_key is derived, not stored anywhere else.",
    "period_key formats: '2026-08-07' (daily), '2026-W32' (weekly), '2026-08-01_2026-08-07' (custom).",
    "A period counts as MISSED by absence: now > due_at and no row exists with that period_key for that user.",
    "metrics_json is a SNAPSHOT frozen at submit. Never recompute a submitted report from live habit data - the partner confirmed a specific number."
  ],
  "fields": {
    "id": {"type": "auto_number", "primary": true},
    "campaign_id": {"type": "link", "link_to": "campaigns", "required": true},
    "participant_id": {"type": "link", "link_to": "campaign_participants", "required": true},
    "campaign_key": {"type": "text", "required": true},
    "user_id": {"type": "text", "required": true},
    "period_key": {"type": "text", "required": true, "description": "Deterministically derived from locked rules + date"},
    "period_start": {"type": "date_time", "required": true},
    "period_end": {"type": "date_time", "required": true},
    "report_status": {"type": "single_select", "options": ["draft", "submitted", "missed", "excused"], "default": "draft"},
    "self_claim": {"type": "single_select", "options": ["pass", "fail", "partial"], "description": "Pre-filled from computed metrics but always user-editable"},
    "metrics_json": {"type": "long_text", "description": "Frozen snapshot computed from the user's habit data at submit time"},
    "target_value": {"type": "number"},
    "actual_value": {"type": "number"},
    "completion_rate": {"type": "number", "description": "0-100"},
    "streak_at_report": {"type": "number"},
    "note": {"type": "long_text", "description": "The user's own words"},
    "proof_url": {"type": "url"},
    "submitted_at": {"type": "date_time"},
    "confirm_status": {"type": "single_select", "options": ["awaiting", "confirmed", "challenged", "auto_confirmed"], "default": "awaiting"},
    "confirmed_by_user_id": {"type": "text"},
    "confirmed_at": {"type": "date_time"},
    "challenge_reason": {"type": "long_text"},
    "created_at": {"type": "date", "auto_now_add": true},
    "updated_at": {"type": "date", "auto_now": true}
  },
