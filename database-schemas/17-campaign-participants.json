{
  "table_name": "campaign_participants",
  "description": "Who is in a campaign, and exactly which version of the rules they consented to. Import SEVENTEENTH (depends on campaigns)",
  "import_order": 17,
  "dependencies": ["campaigns"],
  "notes": [
    "Lock is only legal when every non-observer participant's accepted_rules_hash equals the campaign's current rules hash.",
    "Any propose_rules resets every participant's accepted_rules_version to 0 - changing terms invalidates prior consent.",
    "campaign_key duplicates the parent's key so clients can filter without knowing the numeric row id.",
    "The periods_* counters are denormalized caches; the client recomputes them from campaign_reports and never trusts them for adjudication."
  ],
  "fields": {
    "id": {"type": "auto_number", "primary": true},
    "campaign_id": {"type": "link", "link_to": "campaigns", "required": true},
    "campaign_key": {"type": "text", "required": true},
    "user_id": {"type": "text", "required": true},
    "user_name": {"type": "text"},
    "user_email": {"type": "text", "description": "Lowercased"},
    "user_avatar_url": {"type": "url"},
    "role": {"type": "single_select", "options": ["owner", "partner", "arbiter", "observer"], "default": "partner"},
    "invite_status": {"type": "single_select", "options": ["invited", "accepted", "declined", "left"], "default": "invited"},
    "accepted_rules_version": {"type": "number", "default": 0, "description": "0 means the current rules are not accepted"},
    "accepted_rules_hash": {"type": "text"},
    "periods_reported": {"type": "number", "default": 0},
    "periods_missed": {"type": "number", "default": 0},
    "periods_confirmed": {"type": "number", "default": 0},
    "personal_outcome": {"type": "single_select", "options": ["pending", "success", "failure", "forfeit", "void"], "default": "pending"},
    "invited_at": {"type": "date_time"},
    "joined_at": {"type": "date_time"},
    "created_at": {"type": "date", "auto_now_add": true},
    "updated_at": {"type": "date", "auto_now": true}
  },
