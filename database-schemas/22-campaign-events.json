{
  "table_name": "campaign_events",
  "description": "Append-only audit trail with a hash chain. Tamper-EVIDENCE, not tamper-resistance. Import TWENTY-SECOND (depends on campaigns)",
  "import_order": 22,
  "dependencies": ["campaigns"],
  "notes": [
    "READ THIS BEFORE RELYING ON IT: the Baserow API token ships in the client bundle, so every user can write and delete any row in this table. The hash chain makes tampering VISIBLE to an attentive counterparty; it does not PREVENT it.",
    "Genuine integrity requires routing writes through a server-side proxy that verifies the Xano JWT. Until then, do not enable real cash stakes.",
    "hash = sha256(prev_hash + '|' + seq + '|' + event_type + '|' + actor_user_id + '|' + payload_json). seq starts at 1 with prev_hash = ''.",
    "NEVER updated. Corrections are new events, not edits."
  ],
  "fields": {
    "id": {"type": "auto_number", "primary": true},
    "campaign_id": {"type": "link", "link_to": "campaigns", "required": true},
    "campaign_key": {"type": "text", "required": true},
    "seq": {"type": "number", "required": true, "description": "1-based, monotonic per campaign"},
    "event_type": {"type": "single_select", "options": ["created", "invited", "invite_accepted", "invite_declined", "rules_proposed", "rules_accepted", "locked", "unlock_requested", "activated", "report_submitted", "report_confirmed", "report_challenged", "breach_detected", "outcome_declared", "outcome_challenged", "dispute_resolution_proposed", "dispute_resolved", "forfeited", "cancelled", "pledge_locked", "settlement_created", "settlement_reported", "settlement_confirmed", "settlement_waived"], "required": true},
    "actor_user_id": {"type": "text", "required": true},
    "actor_name": {"type": "text"},
    "payload_json": {"type": "long_text"},
    "prev_hash": {"type": "text", "description": "Empty string for seq 1"},
    "hash": {"type": "text", "required": true},
    "created_at": {"type": "date_time", "auto_now_add": true}
  },
