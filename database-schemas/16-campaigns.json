{
  "table_name": "campaigns",
  "description": "A shared, time-boxed accountability agreement between two or more users. Import SIXTEENTH (no dependencies)",
  "import_order": 16,
  "dependencies": [],
  "notes": [
    "rules_json is MUTABLE while status is draft/negotiating. locked_rules_json is written ONCE at lock and is the only rules source read afterwards.",
    "locked_rules_hash = sha256 of the canonicalized (key-sorted) locked_rules_json. Clients re-verify on load; a mismatch raises a tamper banner.",
    "campaign_key is a client-generated string id so children can reference the campaign before its numeric row id exists.",
    "Four campaign types share this one table; they differ only in the `terms` block inside rules_json."
  ],
  "fields": {
    "id": {"type": "auto_number", "primary": true},
    "campaign_key": {"type": "text", "required": true, "description": "Client-generated stable string id"},
    "title": {"type": "text", "required": true},
    "description": {"type": "long_text"},
    "type": {"type": "single_select", "options": ["shared_goal", "longrun_accountability", "challenge", "stake_return"], "required": true},
    "status": {"type": "single_select", "options": ["draft", "invited", "negotiating", "locked", "active", "completed", "failed", "forfeited", "cancelled", "disputed"], "default": "draft"},
    "owner_user_id": {"type": "text", "required": true},
    "owner_name": {"type": "text"},
    "cadence": {"type": "single_select", "options": ["daily", "weekly", "custom"], "default": "daily"},
    "starts_on": {"type": "date", "required": true},
    "ends_on": {"type": "date", "description": "Null for open-ended longrun_accountability campaigns"},
    "timezone": {"type": "text", "required": true, "description": "IANA zone, e.g. America/New_York. Period math uses this, never the browser's zone"},
    "current_rules_version": {"type": "number", "default": 1},
    "rules_json": {"type": "long_text", "description": "Working rules while draft/negotiating"},
    "locked_rules_json": {"type": "long_text", "description": "Immutable snapshot, written once at lock"},
    "locked_rules_version": {"type": "number"},
    "locked_rules_hash": {"type": "text", "description": "sha256 hex of canonicalized locked_rules_json"},
    "locked_at": {"type": "date_time"},
    "outcome": {"type": "single_select", "options": ["pending", "success", "failure", "partial", "void"], "default": "pending"},
    "outcome_declared_at": {"type": "date_time"},
    "outcome_declared_by": {"type": "text"},
    "dispute_reason": {"type": "long_text"},
    "created_at": {"type": "date", "auto_now_add": true},
    "updated_at": {"type": "date", "auto_now": true}
  },
  "sample_data": [
