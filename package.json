{
  "name": "habiti",
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "nx serve habiti",
    "watch": "nx build habiti --watch --configuration development",
    "build": "nx build habiti",
    "test": "nx test habiti",
    "build:all": "nx run-many -t build",
    "test:ci": "nx run-many -t test -- --watch=false --browsers=ChromeHeadless",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "verify:bundle": "node scripts/check-bundle.mjs",
    "verify:assets": "node scripts/check-assets.mjs",
    "verify:legal": "node scripts/check-legal.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:ci && npm run build && npm run verify:bundle && npm run verify:assets && npm run verify:legal"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@emailjs/browser": "^4.4.1",
    "@rive-app/canvas": "^2.39.2",
    "hls.js": "^1.6.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^20.2.2",
    "@angular-devkit/schematics": "^20.2.2",
    "@angular/build": "^20.3.1",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.0",
    "@eslint/js": "~8.57.0",
    "@nx/angular": "21.6.11",
    "@nx/eslint": "21.6.11",
    "@nx/eslint-plugin": "21.6.11",
    "@nx/workspace": "21.6.11",
    "@schematics/angular": "^20.2.2",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.1.9",
    "eslint": "~8.57.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nx": "21.6.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
